# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in ONE provider.
#
# The app is fully usable without any of these: browsing, chapter/topic
# indexes, stored questions, Smart Practice, Revision Mode, Random 20 and
# progress tracking all work without any AI key.
#
# Keys are read by the backend only. They are never sent to the browser and
# never written into the static build.
#
# These names must match backend/providers/*.ts exactly.
# ---------------------------------------------------------------------------

# Port the Express API and the static frontend are served from.
PORT=8787

# --- Option 1: OpenCode Zen (https://opencode.ai/docs/zen) ------------------
# Any key from your Zen account. Covers GPT, Claude, Gemini, Grok and others,
# but each family has its own endpoint shape - see opencode-zen.ts.
#
# IMPORTANT: a key does not automatically grant every model. If a model is not
# enabled for your account you get HTTP 403 "Model access is disabled" and the
# app will fall back to the next configured provider. Check which models your
# key can reach at https://opencode.ai/zen before setting OPENCODE_MODEL.
#
# Reasoning models ("thinking" models) spend most of their output budget on
# internal reasoning, so they need a large budget and a long timeout or they
# return an empty response with finish_reason=length.
#   OPENCODE_TIMEOUT_MS=300000   how long a single AI call may take
#   OPENCODE_MAX_TOKENS=12000    output budget for question generation
# OPENCODE_API_KEY=
# OPENCODE_MODEL=

# --- Option 2: Google Gemini ------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- Option 3: Ollama (local, no key needed) -------------------------------
# Install Ollama, pull a model, then set AI_PROVIDER=ollama below.
#   ollama pull qwen2.5:7b
# Note: Ollama is never auto-selected. Without AI_PROVIDER=ollama the app
# prefers a real API key and only falls back when none is present.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# --- Optional: force one provider instead of auto-detecting -----------------
# One of: opencode-zen | gemini | ollama
# AI_PROVIDER=
